POSTGRES_PASSWORD=change-me-in-a-real-local-env
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Development-only demo administrator. Replace both values outside local development.
CLOUDOPS_DEFAULT_ADMIN_EMAIL=admin@cloudops.local
CLOUDOPS_DEFAULT_ADMIN_PASSWORD=AdminPass123!
AI_API_KEY=
AI_ENDPOINT=
AI_DEPLOYMENT=
AI_API_VERSION=2024-10-21
AI_MODEL=gpt-4o-mini
